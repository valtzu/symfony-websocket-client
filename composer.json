{
    "name": "valtzu/symfony-websocket-client",
    "description": "WebSocket client implementing Symfony HttpClientInterface",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Valtzu\\WebSocketClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Valtzu\\WebSocketClient\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "symfony/framework-bundle": "To use the ValtzuWebSocketClientBundle",
        "symfony/web-profiler-bundle": "To inspect WebSocket connections in the profiler"
    }
}
